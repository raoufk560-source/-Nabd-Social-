# ===== مطلوب =====
# رابط قاعدة بيانات PostgreSQL (مثال: Neon). انسخه من لوحة Neon -> Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ===== اختياري =====
NODE_ENV="production"

# معرّف Google OAuth (اختياري)
GOOGLE_CLIENT_ID=""

# خادم TURN للمكالمات الصوتية خلف الشبكات المقيّدة (اختياري)
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""
